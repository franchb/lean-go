module
public meta import LeanGo.Module.Records
public meta import Lean.Compiler.LCNF.Closure
public meta import Lean.Meta
public meta import Lean.Util.CollectFVars
public meta section
open Lean Lean.Compiler.LCNF
namespace LeanGo.Module

-- Check full source schemas before compiler erasure, including unused fields.
def validateSourceTypes (used : List String) : CoreM Unit := do
  let mut pending := used
  let mut seen : List String := []
  let mut fuel := 1000
  while !pending.isEmpty do
    if fuel == 0 then throwError "Local source ADT closure limit"
    fuel := fuel - 1
    let name := pending.head!
    pending := pending.tail!
    unless name == "UInt32" || seen.contains name do
      seen := name :: seen
      discard <| typeKey (.const name.toName [])
      let info ← getConstInfoInduct name.toName
      if info.isUnsafe || info.ctors.isEmpty then throwError "Unsupported local source ADT: {name}"
      for i in [:info.ctors.length] do
        let ctorName := info.ctors[i]!
        let ctor ← getConstInfoCtor ctorName
        let (target, fields) ← constructor ctorName
        unless target == name && ctor.cidx == i do throwError "Local constructor schema mismatch: {ctorName}"
        pending := fields ++ pending

def validateLocalType (type : Expr) : CoreM Unit := do
  let (domains, result) ← signature type
  validateSourceTypes (domains ++ [result])

structure LocalSourceWitness where
  binderName : Name
  type : Expr
  deriving Inhabited, BEq

-- Restrict source inspection to function-valued let bindings, not motives or
-- dictionary arguments generated by elaboration. The value can be a conditional
-- or another function expression; an unused binding can disappear before LCNF.
private partial def sourceLets (e : Expr) : MetaM (Array LocalSourceWitness) := do
  match e with
  | .lam n type body bi => Meta.withLocalDecl n bi type fun x => sourceLets (body.instantiate1 x)
  | .letE n type value body _ =>
    let mut witnesses := #[]
    if (← Meta.whnf type) matches .forallE .. then
      validateLocalType type
      for f in (collectFVars {} value).fvarIds do
        let capture ← typeKey (← f.getType)
        validateSourceTypes [capture]
      witnesses := witnesses.push { binderName := n, type }
    witnesses := witnesses ++ (← sourceLets value)
    let rest ← Meta.withLetDecl n type value fun x => sourceLets (body.instantiate1 x)
    return witnesses ++ rest
  | .app f a => return (← sourceLets f) ++ (← sourceLets a)
  | .mdata _ e | .proj _ _ e => sourceLets e
  | _ => return #[]

def localSourceWitnesses (name : Name) : CoreM (Array LocalSourceWitness) := do
  let info ← getConstInfo name
  let some value := info.value? | return #[]
  -- Meta telescopes allocate fresh IDs. Observation must not perturb compiler
  -- naming, hash iteration order, or the resulting generated program.
  let saved ← getNGen
  try
    sourceLets value |>.run'
  finally
    setNGen saved

structure LocalSource where
  sourceOwner : Name
  sourceDecl : Decl .pure := default
  witnesses : Array LocalSourceWitness := #[]
  localDecl : FunDecl .pure
  captures : Array (Param .pure)
  deriving Inhabited

partial def sourceAlias (code : Code .pure) (decl : FunDecl .pure)
    (witnesses : Array LocalSourceWitness) : Bool :=
  match code with
  | .let alias next =>
    (alias.value == .fvar decl.fvarId #[] && alias.type == decl.type &&
      witnesses.any (fun w => w.binderName == alias.binderName && w.type == alias.type)) ||
      sourceAlias next decl witnesses
  | .fun _ next | .jp _ next => sourceAlias next decl witnesses
  | .cases c => c.alts.any (fun a => sourceAlias a.getCode decl witnesses)
  | _ => false

partial def collectLocalSources (owner : Name) (code : Code .pure) (scope : Array FVarId)
    (witnesses : Array LocalSourceWitness) (nested := false) : CompilerM (Array LocalSource) := do
  match code with
  | .let decl next => collectLocalSources owner next (scope.push decl.fvarId) witnesses nested
  | .fun decl next =>
    let witnessed := witnesses.any (fun w => w.binderName == decl.binderName && w.type == decl.type) ||
      sourceAlias next decl witnesses
    unless witnessed do
      -- Compiler-created lambdas may optimize away in already supported source
      -- definitions. They grant no authority if they survive to lifting.
      let inside ← collectLocalSources owner decl.value (scope ++ decl.params.map (·.fvarId)) witnesses true
      return inside ++ (← collectLocalSources owner next (scope.push decl.fvarId) witnesses nested)
    if nested then throwError "Nested local helpers unsupported: {owner}.{decl.binderName}"
    validateLocalType decl.type
    for p in decl.params do validateSourceTypes [← typeKey p.type]
    let (_, captures, _) ← Closure.run (Closure.collectFunDecl decl) scope.contains
    for p in captures do validateSourceTypes [← typeKey p.type]
    discard <| collectLocalSources owner decl.value (scope ++ decl.params.map (·.fvarId)) witnesses true
    let rest ← collectLocalSources owner next (scope.push decl.fvarId) witnesses nested
    return #[{ sourceOwner := owner, localDecl := decl, captures }] ++ rest
  | .jp decl next =>
    let inside ← collectLocalSources owner decl.value (scope ++ decl.params.map (·.fvarId)) witnesses nested
    return inside ++ (← collectLocalSources owner next (scope.push decl.fvarId) witnesses nested)
  | .cases c =>
    c.alts.foldlM (init := #[]) fun found alt => do
      let scope := match alt with
        | .alt _ ps _ _ => scope ++ ps.map (·.fvarId)
        | _ => scope
      return found ++ (← collectLocalSources owner alt.getCode scope witnesses nested)
  | _ => return #[]

end LeanGo.Module
