{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lean-to-Go diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "success",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "lean-go-diagnostics/v1"
    },
    "success": {
      "const": false
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "stage",
          "message",
          "declaration",
          "compiler_form",
          "location",
          "hint"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "stage": {
            "enum": [
              "input",
              "toolchain",
              "build",
              "admission",
              "emission"
            ]
          },
          "message": {
            "type": "string"
          },
          "declaration": {
            "type": [
              "string",
              "null"
            ]
          },
          "compiler_form": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "declaration",
              "start",
              "end"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "declaration",
                  "source_owner",
                  "compiler"
                ]
              },
              "declaration": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "$ref": "#/$defs/position"
              },
              "end": {
                "$ref": "#/$defs/position"
              }
            }
          },
          "hint": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "utf16_column",
        "byte_offset"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "utf16_column": {
          "type": "integer",
          "minimum": 0
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
