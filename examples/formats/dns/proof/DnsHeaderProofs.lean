theorem w3_bytes (W : Nat) (hW : W < 65536) : W / 256 % 256 * 256 + W % 256 = W := by
  have e1 : W % 65536 = W % 256 + 256 * (W / 256 % 256) := Nat.mod_mul (x := W) (a := 256) (b := 256)
  have e2 : W % 65536 = W := Nat.mod_eq_of_lt hW
  generalize W / 256 % 256 = f0 at *
  generalize W % 256 = f1 at *
  generalize W % 65536 = m2 at *
  omega
theorem w3_rt (v0 : Nat) (r0 : v0 < 65536) :
    (v0 * 1) / 256 % 256 * 256 + (v0 * 1) % 256 = v0 := by
  rw [w3_bytes (v0 * 1) (by omega)]
  omega
theorem w3_bext_0 (a0 a1 : Nat) (r0 : a0 < 256) (r1 : a1 < 256) :
    (a0 * 256 + a1) / 256 % 256 = a0 := by
  rw [show a0 * 256 + a1 = (a1) + a0 * 256 + 0 * (256 * 256) by omega]
  exact extract _ a0 _ 256 256 (by decide) (by omega) r0
theorem w3_bext_1 (a0 a1 : Nat) (r0 : a0 < 256) (r1 : a1 < 256) :
    (a0 * 256 + a1) % 256 = a1 := by
  rw [show a0 * 256 + a1 = a1 + (a0 * 1) * 256 by omega]
  exact extract0 a1 _ 256 r1
theorem w3_xbound (a0 a1 : Nat) (r0 : a0 < 256) (r1 : a1 < 256) : a0 * 256 + a1 < 65536 := by omega
theorem w3_inj (a0 a1 b0 b1 : Nat) (ra0 : a0 < 256) (ra1 : a1 < 256) (rb0 : b0 < 256) (rb1 : b1 < 256)
    (f0 : a0 * 256 + a1 = b0 * 256 + b1) :
    a0 = b0 ∧ a1 = b1 := by
  have e : a0 * 256 + a1 = b0 * 256 + b1 := f0
  refine ⟨?_, ?_⟩
  · rw [← w3_bext_0 a0 a1 ra0 ra1, ← w3_bext_0 b0 b1 rb0 rb1, e]
  · rw [← w3_bext_1 a0 a1 ra0 ra1, ← w3_bext_1 b0 b1 rb0 rb1, e]

