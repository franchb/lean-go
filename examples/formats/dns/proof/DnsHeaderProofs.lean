theorem wire_ext (a b : Wire) (e0 : a.b0.toNat = b.b0.toNat) (e1 : a.b1.toNat = b.b1.toNat) (e2 : a.b2.toNat = b.b2.toNat) (e3 : a.b3.toNat = b.b3.toNat) (e4 : a.b4.toNat = b.b4.toNat) (e5 : a.b5.toNat = b.b5.toNat) (e6 : a.b6.toNat = b.b6.toNat) (e7 : a.b7.toNat = b.b7.toNat) (e8 : a.b8.toNat = b.b8.toNat) (e9 : a.b9.toNat = b.b9.toNat) (e10 : a.b10.toNat = b.b10.toNat) (e11 : a.b11.toNat = b.b11.toNat) : a = b := by
  cases a; cases b
  simp only [Wire.mk.injEq]
  exact ⟨UInt8.toNat_inj.mp e0, UInt8.toNat_inj.mp e1, UInt8.toNat_inj.mp e2, UInt8.toNat_inj.mp e3, UInt8.toNat_inj.mp e4, UInt8.toNat_inj.mp e5, UInt8.toNat_inj.mp e6, UInt8.toNat_inj.mp e7, UInt8.toNat_inj.mp e8, UInt8.toNat_inj.mp e9, UInt8.toNat_inj.mp e10, UInt8.toNat_inj.mp e11⟩

theorem parse_serialize (h : Header) (hv : h.qr.toNat < 2 ∧
      h.opcode.toNat < 16 ∧
      h.aa.toNat < 2 ∧
      h.tc.toNat < 2 ∧
      h.rd.toNat < 2 ∧
      h.ra.toNat < 2 ∧
      h.rcode.toNat < 16) :
    parse (serialize h) = .ok h := by
  obtain ⟨v0, v1, v2, v3, v4, v5, v6⟩ := hv
  have q_id := u16_lt h.id
  have q_qr := u8_lt h.qr
  have r_qr : h.qr.toNat < 2 := by omega
  have q_opcode := u8_lt h.opcode
  have r_opcode : h.opcode.toNat < 16 := by omega
  have q_aa := u8_lt h.aa
  have r_aa : h.aa.toNat < 2 := by omega
  have q_tc := u8_lt h.tc
  have r_tc : h.tc.toNat < 2 := by omega
  have q_rd := u8_lt h.rd
  have r_rd : h.rd.toNat < 2 := by omega
  have q_ra := u8_lt h.ra
  have r_ra : h.ra.toNat < 2 := by omega
  have q_rcode := u8_lt h.rcode
  have r_rcode : h.rcode.toNat < 16 := by omega
  have q_qdcount := u16_lt h.qdcount
  have q_ancount := u16_lt h.ancount
  have q_nscount := u16_lt h.nscount
  have q_arcount := u16_lt h.arcount
  apply (parse_ok_iff (serialize h) h).mpr
  rw [ser_b0 h, ser_b1 h, ser_b2 h r_qr r_opcode r_aa r_tc r_rd r_ra r_rcode, ser_b3 h r_qr r_opcode r_aa r_tc r_rd r_ra r_rcode, ser_b4 h, ser_b5 h, ser_b6 h, ser_b7 h, ser_b8 h, ser_b9 h, ser_b10 h, ser_b11 h]
  have t0 := w0_rt h.id.toNat q_id
  have t1 := w1_rt h.qr.toNat h.opcode.toNat h.aa.toNat h.tc.toNat h.rd.toNat h.ra.toNat 0 h.rcode.toNat r_qr r_opcode r_aa r_tc r_rd r_ra (by decide) r_rcode
  have t2 := w2_rt h.qdcount.toNat q_qdcount
  have t3 := w3_rt h.ancount.toNat q_ancount
  have t4 := w4_rt h.nscount.toNat q_nscount
  have t5 := w5_rt h.arcount.toNat q_arcount
  exact ⟨t1.2.2.2.2.2.2.1, ⟨(t0).symm, (t1.1).symm, (t1.2.1).symm, (t1.2.2.1).symm, (t1.2.2.2.1).symm, (t1.2.2.2.2.1).symm, (t1.2.2.2.2.2.1).symm, (t1.2.2.2.2.2.2.2).symm, (t2).symm, (t3).symm, (t4).symm, (t5).symm⟩⟩

theorem parse_inj (a b : Wire) (h : Header) (ha : parse a = .ok h) (hb : parse b = .ok h) : a = b := by
  obtain ⟨ca0, ⟨da0, da1, da2, da3, da4, da5, da6, da7, da8, da9, da10, da11⟩⟩ := (parse_ok_iff a h).mp ha
  obtain ⟨cb0, ⟨db0, db1, db2, db3, db4, db5, db6, db7, db8, db9, db10, db11⟩⟩ := (parse_ok_iff b h).mp hb
  have k0 := w0_inj a.b0.toNat a.b1.toNat b.b0.toNat b.b1.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da0.symm.trans db0)
  have k1 := w1_inj a.b2.toNat a.b3.toNat b.b2.toNat b.b3.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da1.symm.trans db1) (da2.symm.trans db2) (da3.symm.trans db3) (da4.symm.trans db4) (da5.symm.trans db5) (da6.symm.trans db6) (ca0.trans cb0.symm) (da7.symm.trans db7)
  have k2 := w2_inj a.b4.toNat a.b5.toNat b.b4.toNat b.b5.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da8.symm.trans db8)
  have k3 := w3_inj a.b6.toNat a.b7.toNat b.b6.toNat b.b7.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da9.symm.trans db9)
  have k4 := w4_inj a.b8.toNat a.b9.toNat b.b8.toNat b.b9.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da10.symm.trans db10)
  have k5 := w5_inj a.b10.toNat a.b11.toNat b.b10.toNat b.b11.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da11.symm.trans db11)
  exact wire_ext a b k0.1 k0.2 k1.1 k1.2 k2.1 k2.2 k3.1 k3.2 k4.1 k4.2 k5.1 k5.2

theorem parsed_valid (w : Wire) (h : Header) (hp : parse w = .ok h) :
    h.qr.toNat < 2 ∧
    h.opcode.toNat < 16 ∧
    h.aa.toNat < 2 ∧
    h.tc.toNat < 2 ∧
    h.rd.toNat < 2 ∧
    h.ra.toNat < 2 ∧
    h.rcode.toNat < 16 := by
  obtain ⟨c0, ⟨d0, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11⟩⟩ := (parse_ok_iff w h).mp hp
  exact ⟨(by rw [d1]; exact Nat.mod_lt _ (by decide)), (by rw [d2]; exact Nat.mod_lt _ (by decide)), (by rw [d3]; exact Nat.mod_lt _ (by decide)), (by rw [d4]; exact Nat.mod_lt _ (by decide)), (by rw [d5]; exact Nat.mod_lt _ (by decide)), (by rw [d6]; exact Nat.mod_lt _ (by decide)), (by rw [d7]; exact Nat.mod_lt _ (by decide))⟩

theorem serialize_parse (w : Wire) (h : Header) (hp : parse w = .ok h) :
    serialize h = w := by
  exact parse_inj (serialize h) w h (parse_serialize h (parsed_valid w h hp)) hp

theorem parse_validate (w : Wire) (h : Header) (hp : parse w = .ok h) :
    validate h = .valid := by
  exact (validate_valid_iff h).mpr (parsed_valid w h hp)

end DnsHeaderProofs
