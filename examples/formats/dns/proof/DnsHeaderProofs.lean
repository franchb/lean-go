  rw [ite_eq_left ((cond_0 w).mpr c0)]
  cases h
  rw [ParseResult.ok.injEq, Header.mk.injEq, hd_id, hd_qr, hd_opcode, hd_aa, hd_tc, hd_rd, hd_ra, hd_rcode, hd_qdcount, hd_ancount, hd_nscount, hd_arcount]
