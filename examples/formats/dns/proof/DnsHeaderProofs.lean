/-! Serialization, byte by byte. -/

theorem sw1_toNat (h : Header) (r_qr : h.qr.toNat < 2) (r_opcode : h.opcode.toNat < 16) (r_aa : h.aa.toNat < 2) (r_tc : h.tc.toNat < 2) (r_rd : h.rd.toNat < 2) (r_ra : h.ra.toNat < 2) (r_rcode : h.rcode.toNat < 16) :
    (word1 h.qr h.opcode h.aa h.tc h.rd h.ra h.rcode).toNat = h.qr.toNat * 32768 + h.opcode.toNat * 2048 + h.aa.toNat * 1024 + h.tc.toNat * 512 + h.rd.toNat * 256 + h.ra.toNat * 128 + 0 * 16 + h.rcode.toNat * 1 := by
  have := u8_lt h.qr
  have := u8_lt h.opcode
  have := u8_lt h.aa
  have := u8_lt h.tc
  have := u8_lt h.rd
  have := u8_lt h.ra
  have := u8_lt h.rcode
  simp [word1] <;> omega
theorem ser_b0 (h : Header)  :
    (serialize h).b0.toNat = (h.id.toNat * 1) / 256 % 256 := by
  have := u16_lt h.id
  simp [serialize, Nat.shiftRight_eq_div_pow] <;> omega
theorem ser_b1 (h : Header)  :
    (serialize h).b1.toNat = (h.id.toNat * 1) % 256 := by
  have := u16_lt h.id
  simp [serialize, Nat.shiftRight_eq_div_pow] <;> omega
theorem ser_b2 (h : Header) (r_qr : h.qr.toNat < 2) (r_opcode : h.opcode.toNat < 16) (r_aa : h.aa.toNat < 2) (r_tc : h.tc.toNat < 2) (r_rd : h.rd.toNat < 2) (r_ra : h.ra.toNat < 2) (r_rcode : h.rcode.toNat < 16) :
    (serialize h).b2.toNat = (h.qr.toNat * 32768 + h.opcode.toNat * 2048 + h.aa.toNat * 1024 + h.tc.toNat * 512 + h.rd.toNat * 256 + h.ra.toNat * 128 + 0 * 16 + h.rcode.toNat * 1) / 256 % 256 := by
  simp only [serialize]
  rw [UInt32.toNat_toUInt8, UInt32.toNat_shiftRight, sw1_toNat h r_qr r_opcode r_aa r_tc r_rd r_ra r_rcode] <;> simp [Nat.shiftRight_eq_div_pow]
