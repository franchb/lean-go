    (serialize h).b3.toNat = (h.qr.toNat * 32768 + h.opcode.toNat * 2048 + h.aa.toNat * 1024 + h.tc.toNat * 512 + h.rd.toNat * 256 + h.ra.toNat * 128 + 0 * 16 + h.rcode.toNat * 1) % 256 := by
  simp only [serialize]
  rw [UInt32.toNat_toUInt8, sw1_toNat h r_qr r_opcode r_aa r_tc r_rd r_ra r_rcode] <;> simp [Nat.shiftRight_eq_div_pow]
