  have k1 := w1_inj a.b1.toNat b.b1.toNat (u8_lt _) (u8_lt _) (ca1.trans cb1.symm) (da0.symm.trans db0)
  have k2 := w2_inj a.b2.toNat a.b3.toNat b.b2.toNat b.b3.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da1.symm.trans db1)
