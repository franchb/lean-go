-- Code generated by lean-go format from the header spec; DO NOT EDIT.
-- Expected propositions, stated from the format spec independently of the proofs.
-- Byte b<i> is wire byte i; multi-byte values are written out in base 256.
import DemoHeader

namespace DemoHeaderContract

/-- A successful parse is exactly: every check holds and every field is the stated function of the bytes. -/
def parse_ok_iff : Prop :=
  ∀ (w : Wire) (h : Header),
    DemoHeader.parse w = .ok h ↔
      (w.b0.toNat = 1 ∧
       w.b1.toNat / 4 % 64 = 0) ∧
      (h.flags.toNat = w.b1.toNat % 4 ∧
       h.length.toNat = w.b2.toNat * 256 + w.b3.toNat)

/-- parse reports versionMismatch exactly when the earlier checks pass and this one fails. -/
def parse_versionMismatch_iff : Prop :=
  ∀ (w : Wire),
    DemoHeader.parse w = .versionMismatch ↔
      ¬w.b0.toNat = 1

/-- parse reports reservedNonzero exactly when the earlier checks pass and this one fails. -/
def parse_reservedNonzero_iff : Prop :=
  ∀ (w : Wire),
    DemoHeader.parse w = .reservedNonzero ↔
      w.b0.toNat = 1 ∧
      ¬w.b1.toNat / 4 % 64 = 0

/-- parse accepts exactly the byte strings on which every declared constraint holds. -/
def accepts_iff : Prop :=
  ∀ (w : Wire),
    (∃ h, DemoHeader.parse w = .ok h) ↔
      w.b0.toNat = 1 ∧
      w.b1.toNat / 4 % 64 = 0

/-- The validity predicate: every field fits its width and satisfies its declared constraints. -/
def validate_valid_iff : Prop :=
  ∀ (h : Header),
    DemoHeader.validate h = .valid ↔
      h.flags.toNat < 4

/-- validate reports flagsTooWide exactly when the earlier checks pass and this one fails. -/
def validate_flagsTooWide_iff : Prop :=
  ∀ (h : Header),
    DemoHeader.validate h = .flagsTooWide ↔
      ¬h.flags.toNat < 4

/-- Serializing a valid header and parsing the bytes returns the header. -/
def parse_serialize : Prop :=
  ∀ (h : Header),
    h.flags.toNat < 4 →
    DemoHeader.parse (DemoHeader.serialize h) = .ok h

/-- Accepted bytes are the serialization of the header they parse to: encodings are unique. -/
def serialize_parse : Prop :=
  ∀ (w : Wire) (h : Header),
    DemoHeader.parse w = .ok h →
    DemoHeader.serialize h = w

/-- Every parsed header is valid. -/
def parse_validate : Prop :=
  ∀ (w : Wire) (h : Header),
    DemoHeader.parse w = .ok h →
    DemoHeader.validate h = .valid

/-- With fewer payload bytes than declared, classify reports the exact deficit. -/
def payload_need_more_iff : Prop :=
  ∀ (h : Header) (available missing : UInt32),
    DemoHeader.classify h available = .needMore missing ↔
      available.toNat < h.length.toNat ∧ missing.toNat = h.length.toNat - available.toNat

/-- With enough payload bytes, classify reports exactly the declared count to consume. -/
def payload_complete_iff : Prop :=
  ∀ (h : Header) (available consumed : UInt32),
    DemoHeader.classify h available = .complete consumed ↔
      h.length.toNat ≤ available.toNat ∧ consumed.toNat = h.length.toNat

end DemoHeaderContract
