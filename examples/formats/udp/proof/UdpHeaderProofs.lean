  have k2 := w2_inj a.b4.toNat a.b5.toNat b.b4.toNat b.b5.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da2.symm.trans db2)
  have k3 := w3_inj a.b6.toNat a.b7.toNat b.b6.toNat b.b7.toNat (u8_lt _) (u8_lt _) (u8_lt _) (u8_lt _) (da3.symm.trans db3)
  exact wire_ext a b k0.1 k0.2 k1.1 k1.2 k2.1 k2.2 k3.1 k3.2

theorem parsed_valid (w : Wire) (h : Header) (hp : parse w = .ok h) :
    8 ≤ h.length.toNat := by
  obtain ⟨c0, ⟨d0, d1, d2, d3⟩⟩ := (parse_ok_iff w h).mp hp
  exact (by rw [d2]; exact c0)

theorem serialize_parse (w : Wire) (h : Header) (hp : parse w = .ok h) :
    serialize h = w := by
  exact parse_inj (serialize h) w h (parse_serialize h (parsed_valid w h hp)) hp

theorem parse_validate (w : Wire) (h : Header) (hp : parse w = .ok h) :
    validate h = .valid := by
  exact (validate_valid_iff h).mpr (parsed_valid w h hp)

theorem payloadLength_toNat (h : Header) : (payloadLength h.length).toNat = h.length.toNat - 8 := by
  unfold payloadLength
  by_cases hl : h.length.toUInt32 < 8
  · rw [ite_eq_left hl]
    have hn : (h.length.toUInt32).toNat < 8 := hl
    rw [UInt16.toNat_toUInt32] at hn
    simp only [UInt32.reduceToNat]; omega
  · rw [ite_eq_right hl]
    have hn : ¬ (h.length.toUInt32).toNat < 8 := hl
    have le : (8 : UInt32) ≤ h.length.toUInt32 := by
      rw [UInt32.le_iff_toNat_le]; exact Nat.le_of_not_gt hn
    rw [UInt32.toNat_sub_of_le _ _ le, UInt16.toNat_toUInt32] <;> rfl

theorem payload_need_more_iff (h : Header) (available missing : UInt32) :
    classify h available = .needMore missing ↔
      available.toNat < h.length.toNat - 8 ∧ missing.toNat = h.length.toNat - 8 - available.toNat := by
  have hl := payloadLength_toNat h
  unfold classify
  by_cases short : available < payloadLength h.length
  · have lt : available.toNat < (payloadLength h.length).toNat := short
    rw [ite_eq_left short, Availability.needMore.injEq, ← UInt32.toNat_inj,
      UInt32.toNat_sub_of_le _ _ (UInt32.le_of_lt short)]
    rw [hl] at lt ⊢
    constructor
    · intro e; exact ⟨lt, e.symm⟩
    · intro e; exact e.2.symm
  · have ge : ¬ available.toNat < (payloadLength h.length).toNat := short
    rw [ite_eq_right short]
    rw [hl] at ge
    exact ⟨fun e => Availability.noConfusion e, fun hh => absurd hh.1 ge⟩

theorem payload_complete_iff (h : Header) (available consumed : UInt32) :
    classify h available = .complete consumed ↔
      h.length.toNat - 8 ≤ available.toNat ∧ consumed.toNat = h.length.toNat - 8 := by
  have hl := payloadLength_toNat h
  unfold classify
  by_cases short : available < payloadLength h.length
  · have lt : available.toNat < (payloadLength h.length).toNat := short
    rw [ite_eq_left short]
    rw [hl] at lt
    exact ⟨fun e => Availability.noConfusion e, fun hh => absurd hh.1 (Nat.not_le_of_lt lt)⟩
  · have ge : ¬ available.toNat < (payloadLength h.length).toNat := short
    rw [ite_eq_right short, Availability.complete.injEq, ← UInt32.toNat_inj]
    rw [hl] at ge ⊢
    constructor
    · intro e; exact ⟨Nat.le_of_not_gt ge, e.symm⟩
    · intro e; exact e.2.symm

end UdpHeaderProofs
