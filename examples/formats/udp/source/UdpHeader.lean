-- Code generated by lean-go-format from udp.json; DO NOT EDIT.
-- Ordinary first-order Lean for the udp header (8 bytes).

/-- The header bytes in wire order. -/
structure Wire where
  b0 : UInt8
  b1 : UInt8
  b2 : UInt8
  b3 : UInt8
  b4 : UInt8
  b5 : UInt8
  b6 : UInt8
  b7 : UInt8

/-- The decoded header: every field that is neither constant nor reserved. -/
structure Header where
  srcPort : UInt16
  dstPort : UInt16
  length : UInt16
  checksum : UInt16

inductive ParseResult where
  | ok (header : Header)
  | lengthTooSmall

inductive Validity where
  | valid
  | lengthTooSmall

inductive Availability where
  | needMore (missing : UInt32)
  | complete (consumed : UInt32)

namespace UdpHeader

def be16w (a b : UInt8) : UInt32 := a.toUInt32 * 256 + b.toUInt32
def be32w (a b c d : UInt8) : UInt32 :=
  a.toUInt32 * 16777216 + b.toUInt32 * 65536 + c.toUInt32 * 256 + d.toUInt32
def be64w (a b c d e f g h : UInt8) : UInt64 :=
  (be32w a b c d).toUInt64 * 4294967296 + (be32w e f g h).toUInt64
def u16 (a b : UInt8) : UInt16 := (a.toUInt16 <<< 8) ||| b.toUInt16
def to16 (v : UInt32) : UInt16 := ((v >>> 8).toUInt8.toUInt16 <<< 8) ||| v.toUInt8.toUInt16


/-- Checks run in wire order; the first failure is reported. -/
def parse (w : Wire) : ParseResult :=
  if 8 ≤ be16w w.b4 w.b5 then
    .ok { srcPort := u16 w.b0 w.b1,
          dstPort := u16 w.b2 w.b3,
          length := u16 w.b4 w.b5,
          checksum := u16 w.b6 w.b7 }
  else .lengthTooSmall

/-- Every Header the format can represent; serialize is specified on these. -/
def validate (h : Header) : Validity :=
  if 8 ≤ h.length.toUInt32 then
    .valid
  else .lengthTooSmall

def serialize (h : Header) : Wire :=
  { b0 := (h.srcPort >>> 8).toUInt8,
    b1 := h.srcPort.toUInt8,
    b2 := (h.dstPort >>> 8).toUInt8,
    b3 := h.dstPort.toUInt8,
    b4 := (h.length >>> 8).toUInt8,
    b5 := h.length.toUInt8,
    b6 := (h.checksum >>> 8).toUInt8,
    b7 := h.checksum.toUInt8 }

/-- The payload byte count the header declares. -/
def payloadLength (length : UInt16) : UInt32 :=
  if length.toUInt32 < 8 then 0 else length.toUInt32 - 8

/-- Classify the payload bytes available after the header. -/
def classify (h : Header) (available : UInt32) : Availability :=
  if available < payloadLength h.length then .needMore (payloadLength h.length - available)
  else .complete (payloadLength h.length)

end UdpHeader
