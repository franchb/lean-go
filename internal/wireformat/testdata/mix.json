{
  "name": "mix",
  "module": "MixHeader",
  "description": "Exercises every spec feature: all widths, both byte orders, bit-fields in 1-, 2- and 4-byte words, constants, reserved bits and bytes, enums, ranges and a payload length that includes the header.",
  "fields": [
    {"name": "magic", "type": "uint32", "const": "0xCAFEBABE"},
    {"bitfield": "uint8", "bits": [
      {"name": "version", "width": 4, "const": 4},
      {"name": "kind", "width": 3, "enum": [1, 2, 5]},
      {"name": "urgent", "width": 1}
    ]},
    {"name": "pad", "type": "uint8", "reserved": true},
    {"name": "total", "type": "uint16", "endian": "little", "max": 9000, "payload_length": {"includes_header": true}},
    {"bitfield": "uint16", "bits": [
      {"name": "flagsHi", "width": 3},
      {"name": "fragment", "width": 13, "max": 8000}
    ]},
    {"bitfield": "uint32", "bits": [
      {"name": "ecn", "width": 2, "lsb": 30},
      {"name": "dscp", "width": 6, "lsb": 24, "min": 1},
      {"name": "label", "width": 20, "lsb": 4},
      {"name": "unused", "width": 4, "lsb": 0, "reserved": true}
    ]},
    {"bitfield": "uint32", "bits": [
      {"name": "big", "width": 31},
      {"name": "last", "width": 1}
    ]},
    {"name": "seq", "type": "uint32", "endian": "little", "min": 1},
    {"name": "stamp", "type": "uint64", "max": 1000000000000},
    {"name": "cookie", "type": "uint64", "endian": "little", "enum": [0, 18446744073709551615]},
    {"name": "tag", "type": "uint8", "min": 3, "max": 200},
    {"name": "port", "type": "uint16"}
  ]
}
